# Copy this file to .env and fill in real values before running the scheduler.
# Do NOT commit .env to git.

# Alpaca paper trading credentials (required)
ALPACA_API_KEY=AKXXXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Keep this false unless you are explicitly authorized to trade real money.
AUREUM_FORCE_LIVE=false

# Optional: push memory/ and live certificates to git after a successful run.
AUREUM_GIT_PUSH=true
