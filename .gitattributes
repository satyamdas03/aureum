# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts and config files
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Rust source files
*.rs text eol=lf

# Python source files
*.py text eol=lf

# Web source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.parquet binary
